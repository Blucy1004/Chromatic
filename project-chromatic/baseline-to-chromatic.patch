+            draw+=float(probs[:,1].sum());n+=count
+    result={key:value/n for key,value in sums.items()}
+    result['wdl_ece']=float(sum(abs(c-t) for count,c,t in bins if count)/n)
+    result['mean_predicted_draw']=draw/n;result['rows']=n
+    return result
+
