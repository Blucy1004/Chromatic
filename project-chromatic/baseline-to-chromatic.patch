+def measurements(model,replay,ids,device):
+    if not ids:return None
+    model.eval();sums={'policy_loss':0.,'wdl_loss':0.,'policy_entropy':0.,'wdl_brier':0.}
+    bins=np.zeros((10,3),dtype=np.float64);draw=0.;n=0
